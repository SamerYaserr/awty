DATABASE_URL=postgres://awty:awty@localhost:5432/awty
DB_POOL_MAX=10
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# HTTP
HTTP_HOST=0.0.0.0
HTTP_PORT=3000

# Logging
LOG_LEVEL=info
LOG_PRETTY=false

# Tasks
TASK_MAX_ATTEMPTS=5
TASK_HEARTBEAT_SECONDS=30
TASK_EXPIRY_GRACE_SECONDS=30
TASK_RETENTION_DAYS=7

# pg-boss
PGBOSS_SCHEMA=pgboss
PGBOSS_POOL_MAX=5

# Worker
WORKER_CONCURRENCY=1000
WORKER_POLL_INTERVAL_MS=500
WORKER_FETCH_BATCH=50
WORKER_SHUTDOWN_TIMEOUT_MS=20000
PROGRESS_FLUSH_INTERVAL_MS=250
SIMULATED_FAILURE_RATE=0

# WebSocket
WS_MAX_SUBSCRIPTIONS=100
WS_PING_INTERVAL_MS=30000
WS_MAX_BUFFERED_BYTES=1048576
RECONCILE_INTERVAL_MS=10000

